      "model_id": "openrouter_gemma_26b",
      "language": "sw",
      "question": "Ada ya kusahihisha jina kwenye tiketi ya safari ya kimataifa ni kiasi gani?",
      "fixed_history": null,
      "reference_answer": "USD 75 for international PNR name correction on a KQ-operated booking (not interline), subject to the stated maximum of three characters and possible fee revisions. This is not transferring the ticket or the separate name-change fee.",
      "expected_behavior": "answer_with_conditions",
      "status": "failed",
      "final_response": null,
      "decision": null,
      "generation_called": true,
      "generation_ms": null,
      "response_time_ms": null,
