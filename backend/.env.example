APP_NAME="KQ Customer Support Chatbot API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG="true"
API_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Firebase project ID; required when using protected endpoints.
FIRESTORE_PROJECT_ID=""
# Local example: '../credentials/firebase-admin.json' (resolved from backend).
# Leave empty to use Application Default Credentials in a managed environment.
FIREBASE_CREDENTIALS_PATH=""

RAW_DATA_DIR="./data/raw"
PROCESSED_DATA_DIR="./data/processed"
CHROMA_PERSIST_DIR="../chroma_db"
# Character target, not a hard cap: preserve complete table rows and complex tables.
RAG_CHUNK_SIZE="1600"
# Maximum prose/whole-row overlap; repeated table context is separate.
RAG_CHUNK_OVERLAP="250"

EMBEDDING_MODEL_NAME="intfloat/multilingual-e5-small"
EMBEDDING_MODEL_REVISION="614241f622f53c4eeff9890bdc4f31cfecc418b3"
EMBEDDING_BATCH_SIZE="4"
EMBEDDING_CACHE_DIR="../model_cache"
RETRIEVAL_TOP_K="5"
DEFAULT_GENERATION_MODEL_ID=""
