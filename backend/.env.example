APP_NAME="KQ Customer Support Chatbot API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG="true"
API_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000"

# Firebase project ID; required when using protected endpoints.
FIRESTORE_PROJECT_ID=""
# Local example: '../credentials/firebase-admin.json' (resolved from backend).
# Leave empty to use Application Default Credentials in a managed environment.
FIREBASE_CREDENTIALS_PATH=""

RAW_DATA_DIR="./data/raw"
PROCESSED_DATA_DIR="./data/processed"
CHROMA_PERSIST_DIR="../chroma_db"
# Character target, not a hard cap: preserve complete table rows and complex tables.
RAG_CHUNK_SIZE="1600"
# Maximum prose/whole-row overlap; repeated table context is separate.
RAG_CHUNK_OVERLAP="250"

EMBEDDING_MODEL_NAME="intfloat/multilingual-e5-small"
EMBEDDING_MODEL_REVISION="614241f622f53c4eeff9890bdc4f31cfecc418b3"
EMBEDDING_BATCH_SIZE="4"
EMBEDDING_CACHE_DIR="../model_cache"
RETRIEVAL_TOP_K="5"
# Includes citation markers/separators; complete chunks are never truncated.
CONTEXT_MAX_CHARS="8000"
# Conservative E5-small development heuristic, NOT probability or verified answerability.
# Recalibrate after model/corpus changes; valid questions may receive clarification.
CONTEXT_MIN_SIMILARITY="0.82"

# Copy this file to backend/.env.
OPENROUTER_API_KEY="replace_with_openrouter_key"
GROQ_API_KEY="replace_with_groq_key"
GROQ_MODEL="openai/gpt-oss-120b"

GENERATION_MODEL_1_ID="openrouter_gemma_26b"
GENERATION_MODEL_1_PROVIDER="openrouter"
GENERATION_MODEL_1_UPSTREAM_MODEL="google/gemma-4-26b-a4b-it"
GENERATION_MODEL_1_TIMEOUT_SECONDS="45"
GENERATION_MODEL_1_MAX_OUTPUT_TOKENS="1024"

GENERATION_MODEL_2_ID="openrouter_gemma_31b"
GENERATION_MODEL_2_PROVIDER="openrouter"
GENERATION_MODEL_2_UPSTREAM_MODEL="google/gemma-4-31b-it"
GENERATION_MODEL_2_TIMEOUT_SECONDS="45"
GENERATION_MODEL_2_MAX_OUTPUT_TOKENS="1024"

GENERATION_MODEL_3_ID="groq_gpt_oss_120b"
GENERATION_MODEL_3_PROVIDER="groq"
GENERATION_MODEL_3_UPSTREAM_MODEL="openai/gpt-oss-120b"
GENERATION_MODEL_3_TIMEOUT_SECONDS="60"
GENERATION_MODEL_3_MAX_OUTPUT_TOKENS="2048"

# Must match one of the three local GENERATION_MODEL_*_ID values.
DEFAULT_GENERATION_MODEL_ID="openrouter_gemma_26b"

# OAG Flight Info API v2. Keep the real key only in backend/.env.
OAG_API_KEY=""
OAG_BASE_URL="https://api.oag.com"
OAG_TIMEOUT_SECONDS="8"
OAG_STATUS_CACHE_SECONDS="60"
OAG_REFRESH_COOLDOWN_SECONDS="15"
# Enable only after confirming that the OAG subscription permits route search.
OAG_ROUTE_SEARCH_ENABLED="false"
