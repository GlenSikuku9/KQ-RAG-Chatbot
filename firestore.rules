rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function administrator() {
      return signedIn() && request.auth.token.role == "admin";
    }

    function ownsSupportRequest(requestId) {
      return signedIn()
        && get(/databases/$(database)/documents/support_requests/$(requestId))
          .data.passenger_id == request.auth.uid;
    }

    // All writes pass through FastAPI, where transitions and assignments are
    // validated transactionally. Clients receive only real-time case reads.
    match /support_requests/{requestId} {
      allow read: if administrator()
        || (signedIn() && resource.data.passenger_id == request.auth.uid);
      allow write: if false;
    }

    match /support_messages/{messageId} {
      allow read: if administrator()
        || ownsSupportRequest(resource.data.request_id);
      allow write: if false;
    }

    // Administrators receive summary change signals for the Conversations
    // table. Message bodies still load only through protected FastAPI routes.
    match /conversations/{conversationId} {
      allow read: if administrator();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
