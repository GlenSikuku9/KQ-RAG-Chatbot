# Public Firebase web configuration. These values identify the Firebase project;
# do not put service-account JSON, OpenRouter keys, or Google AI keys in this file.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
# The FastAPI server URL, without /api/v1.
# Leave this blank for Vite's same-origin /api proxy during local development.
# Set an absolute backend URL only for a separately deployed frontend.
VITE_API_BASE_URL=""
